# Google Gemini API Key
# Получите бесплатный ключ здесь: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Модель Gemini (по умолчанию gemini-2.5-flash)
AI_MODEL=gemini-2.5-flash

# Официальный FACEIT API Key (Server-side key)
# Получите бесплатный ключ здесь: https://developers.faceit.com/
FACEIT_API_KEY=

# Базовый URL сайта (для хостинга или GitHub Pages, например: https://username.github.io/csdemo)
SITE_BASE_URL=
